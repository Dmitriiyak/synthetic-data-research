{
  "project_name": "Synthetic Images for Landmark Classification",

  "generator_model": "Juggernaut XL v9",
  "image_resolution": "704x704",
  "steps": 25,
  "seed_strategy": "random (-1)",

  "train_prompts_per_class": 10,
