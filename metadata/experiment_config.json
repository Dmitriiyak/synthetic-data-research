  "train_images_per_prompt": 30,
  "test_images_per_prompt": 30,

  "classes": [
    "burj_khalifa",
    "chichen_itza",
    "christ_the_redeemer",
    "eiffel_tower",
    "great_wall_of_china",
    "pyramids_of_giza",
    "roman_colosseum",
    "statue_of_liberty"
  ]
}